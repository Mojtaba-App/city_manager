# Normalize text files
* text=auto eol=lf

*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Keep Windows scripts CRLF if added later
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.pbf binary
*.woff binary
*.woff2 binary
