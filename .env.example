# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=city_manager
POSTGRES_USER=city_manager
POSTGRES_PASSWORD=change_me_in_production

# API
API_PORT=3001
API_PREFIX=api/v1
JWT_SECRET=change_me_use_long_random_secret_min_32_chars
PII_ENC_KEY=change_me_separate_32_byte_key_for_pii_encryption
# Optional override for integration/webhook crypto (falls back to PII_ENC_KEY / JWT_SECRET)
# INTEGRATION_ENC_KEY=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
SECRETS_MASTER_KEY=change_me_vault_master_key_min_32_chars
# Local/dev only: show OTP in login API response (never in production)
SHOW_LOGIN_OTP_IN_DEV=1
THROTTLE_TTL=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10

# Optional Redis (OTP, lockout, throttle, presence, notification fan-out)
# When unset, in-memory fallbacks are used (single-instance only)
# REDIS_URL=redis://localhost:6379

# Messaging: async outbox worker (default in-process). Set true for dedicated worker only.
# DISABLE_IN_PROCESS_MESSAGING=false
# Force synchronous first delivery attempt (tests/OTP-friendly): MESSAGING_SYNC_DISPATCH=1

# KPI materialized view refresh (Phase 3)
# DISABLE_KPI_SUMMARY_REFRESH=false
# KPI_SUMMARY_REFRESH_MS=300000

# Swagger: off in production by default. Set SWAGGER_ENABLED=1 to force on (disables CSP).
# Set SWAGGER_ENABLED=0 to force off in non-production.
# SWAGGER_ENABLED=0

# Web (Next) — comma-separated hosts for local cross-origin dev if needed
# ALLOWED_DEV_ORIGINS=localhost:3000,127.0.0.1:3000

# Database pool (tune for concurrent analytical load)
DB_POOL_MAX=40
DB_POOL_MIN=5
DB_STATEMENT_TIMEOUT_MS=30000

# Object storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=city-manager-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
STORAGE_LOCAL_PATH=/tmp/city-manager-uploads

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Observability / deploy
GRAFANA_ADMIN_PASSWORD=change_me_grafana
HTTP_PORT=80
API_REPLICAS=2
WEB_REPLICAS=2
BACKUP_RETENTION_DAYS=30

# Integration sync worker
# true = queue processing only via separate worker (pnpm --filter @city-manager/api start:sync-worker)
DISABLE_IN_PROCESS_SYNC=false

# Report schedule worker
# true = schedules only via separate worker (pnpm --filter @city-manager/api start:report-worker)
DISABLE_IN_PROCESS_REPORT_SCHEDULES=false
REPORT_SCHEDULE_INTERVAL_MS=60000
