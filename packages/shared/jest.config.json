{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "commonjs",
          "target": "ES2022",
          "esModuleInterop": true,
          "strict": true,
          "skipLibCheck": true
        }
      }
    ]
  },
  "testEnvironment": "node"
}
