/**
 * Minimal OpenAPI 3 document committed for offline type generation.
 * Refresh with: pnpm --filter @city-manager/api openapi:export
 */
{
  "openapi": "3.0.0",
  "info": {
    "title": "City Manager API",
    "description": "API پلتفرم مدیریت بازآفرینی شهری",
    "version": "0.1.0"
  },
  "servers": [{ "url": "/api/v1" }],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {},
          "error": { "$ref": "#/components/schemas/ApiError" }
        },
        "required": ["success"]
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "User login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getProfile",
        "summary": "Current user profile",
        "security": [{ "bearer": [] }],
        "responses": {
          "200": {
            "description": "Profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      }
    },
    "/case/households": {
      "get": {
        "operationId": "listHouseholds",
        "summary": "List households",
        "security": [{ "bearer": [] }],
        "responses": {
          "200": {
            "description": "Household list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      }
    },
    "/gis/neighborhoods": {
      "get": {
        "operationId": "listNeighborhoods",
        "summary": "List neighborhoods",
        "security": [{ "bearer": [] }],
        "responses": {
          "200": {
            "description": "Neighborhood list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      }
    }
  }
}
